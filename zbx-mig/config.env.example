# zbx-mig ayarlari — bu dosyayi "config.env" olarak kopyalayip doldurun (chmod 600).
# Scriptler YENI PostgreSQL makinesinde (MySQL klonu) root olarak calisir.

# --- Kaynak 1: KLON uzerindeki MySQL (Faz 1 toplu aktarim buradan okur; canliya yuk binmez)
# Bu makinenin kendi adresi olmak ZORUNDA (127.0.0.1); baska bir adres yazilirsa scriptler calismaz.
CLONE_MYSQL_HOST=127.0.0.1
CLONE_MYSQL_PORT=3306
CLONE_MYSQL_USER=zabbix
CLONE_MYSQL_PASSWORD='DEGISTIR'

# --- Kaynak 2: CANLI MySQL (sadece 05-catchup.sh, 06-cutover.sh ve 00-preflight.sh baglanir; sadece SELECT atilir)
# TEST / TOPLU AKTARIM SIRASINDA BOS BIRAKIN: bos iken hicbir script canli sisteme baglanamaz
# (01, 02, 03, 04, 07 bulk|counts, status canliya ihtiyac duymaz; 05 ve 06 calismayi reddeder).
# Gercek gecisten once doldurulur.
PROD_MYSQL_HOST=
PROD_MYSQL_PORT=3306
PROD_MYSQL_USER=
PROD_MYSQL_PASSWORD=

MYSQL_DB=zabbix

# --- Hedef: bu makinedeki PostgreSQL
ZABBIX_VERSION=7.4.13          # Zabbix server ile birebir ayni olmali
PG_VERSION=17
TSDB_VERSION=2.28.3            # Zabbix 7.4.13 en fazla TimescaleDB 2.28.x destekler; YUKSELTMEYIN
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=zabbix
PG_ZABBIX_USER=zabbix
PG_ZABBIX_PASSWORD='DEGISTIR'  # Zabbix server/frontend bu sifreyle baglanacak
PG_MIG_USER=zbxmig             # gecici superuser; 08-finalize.sh siler
PG_MIG_PASSWORD='DEGISTIR'
ZABBIX_SERVER_IP=              # Zabbix server'in IP'si (sadece pg_hba erisim izni). Testte BOS; gecisten once doldurup ./01-install-postgres.sh hba
PG_MAX_CONNECTIONS=1000        # 00-preflight.sh ciktisindaki oneriye gore ayarlayin
PG_SYNCHRONOUS_COMMIT=off      # off: cokme aninda son ~1 sn'lik veri kaybolabilir, bozulma olmaz (izleme verisi icin onerilir)
PG_STORAGE_SSD=1               # datastore SSD/flash ise 1, donen disk ise 0

# --- Aktarim ayarlari
WORK_DIR=/var/lib/zbxmig       # gecici dosyalar + loglar (bosluk icermemeli)
PARALLEL_BULK=4                # Faz 1: klon MySQL -> PG paralel akis sayisi
PARALLEL_ONLINE=2              # catch-up: CANLI MySQL'den okuyan paralel akis (canliya yuk!)
PARALLEL_CUTOVER=6             # kesinti anindaki paralel akis
BATCH_ITEMS=500                # bir is biriminde kac item
OVERLAP=10800                  # sn; her delta gecisi bir oncekinin baslangicindan bu kadar geriden okur (gec gelen veri icin)
CLONE_TS=                      # klonun alindigi an (epoch). Bos = klondaki veriden otomatik bulunur
COMPRESS_INLINE=1              # 1: her tablo yuklenince eski chunk'lar hemen sikistirilir (disk tepe kullanimini dusurur)
COMPRESS_PARALLEL=2

# --- TimescaleDB housekeeping kararlari (bos = MySQL'deki mevcut deger korunur)
# TimescaleDB ile "Override item history/trend period" ZORUNLU olarak acilir (Zabbix'in kendi kurulum scripti de boyle yapar).
HK_HISTORY=                    # ornek: 90d  -> tum item'lar icin gecerli global history suresi
HK_TRENDS=                     # ornek: 365d
