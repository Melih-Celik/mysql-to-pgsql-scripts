# Zabbix server (d724zbx01) tarafindaki gecis ayarlari — "config.env" olarak kopyalayip doldurun (chmod 600).
NEW_DB_HOST=DEGISTIR            # yeni PostgreSQL makinesinin IP adresi
NEW_DB_PORT=5432
NEW_DB_NAME=zabbix
NEW_DB_USER=zabbix
NEW_DB_PASSWORD='DEGISTIR'      # DB tarafindaki PG_ZABBIX_PASSWORD ile ayni
ZABBIX_VERSION=7.4.13           # kurulu surumle birebir ayni olmali (scriptler kontrol eder)
BACKUP_DIR=/root/zbx-mig-backup
SERVER_CONF=/etc/zabbix/zabbix_server.conf
WEB_CONF=/etc/zabbix/web/zabbix.conf.php
